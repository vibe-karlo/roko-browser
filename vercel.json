{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "Site",
  "ignoreCommand": "for p in $(git rev-parse HEAD^@); do git diff --quiet $p HEAD -- Site vercel.json || exit 1; done",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/(style.css|site.js|beta.js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }] }
  ]
}
